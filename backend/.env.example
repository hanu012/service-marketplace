APP_NAME="Service Marketplace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marketplace
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log = write the rendered email to storage/logs/laravel.log (local dev).
# resend = send for real; requires RESEND_API_KEY.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@servicemarketplace.local"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=

# Where emailed reset / verification links point. Falls back to APP_URL.
FRONTEND_URL=

# Basemap tiles for the admin zone-drawing map. Defaults to OpenStreetMap's
# public server, whose usage policy does NOT cover sustained production use —
# point this at a paid or self-hosted provider before launch.
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
MAP_DEFAULT_LAT=
MAP_DEFAULT_LNG=
MAP_DEFAULT_ZOOM=

# Seed credentials for the first Filament admin:
#   php artisan db:seed --class=AdminUserSeeder
# Set these before seeding on any shared or deployed environment — the
# defaults in AdminUserSeeder are for local development only.
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@servicemarketplace.local
ADMIN_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
